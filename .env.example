# Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key, only used by the digest cron. Same page, marked secret.
SUPABASE_SERVICE_ROLE_KEY=

# Groq: console.groq.com/keys (free, no card)
GROQ_API_KEY=

# Adzuna: developer.adzuna.com/signup (free, no card, ~1000 calls/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Resend: resend.com (free), only needed for the daily digest email
RESEND_API_KEY=

# Optional: protects /api/digest from being called by anyone but Vercel Cron
CRON_SECRET=
